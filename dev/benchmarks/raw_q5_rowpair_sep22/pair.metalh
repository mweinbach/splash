// Private dense R4/K6144/N2560 Q5/G128 paired rows. Original AIR is control.
// Root generates literal.metalh from pinned original QMV_F32XSUM source.
#include "literal.metalh"

namespace raw_q5_rowpair_sep22 {

// Each row retains the original twelve sequential cross-byte accumulations
// per eight values. Only integer bytes/masks and common scale/bias are shared.
// Do not rebuild five-bit coefficients or merge the fragment contributions.
inline void qdot_pair(const device uchar *w,
    const thread float *x0, const thread float *x1,
    float scale, float bias, float sum0, float sum1,
    thread float &dot0, thread float &dot1) {
  float accum0 = 0, accum1 = 0;
  for (int i = 0; i < 2; ++i) {
    // These pointer mutations are literal original chronology, i=0 then i=1.
    x0 += 8 * i;
    x1 += 8 * i;
    w += 5 * i;
    const uchar b0 = w[0], b1 = w[1], b2 = w[2], b3 = w[3], b4 = w[4];
    const int m0 = b0 & 0x1f;
    const int m1 = b0 & 0xe0;
    const int m2 = b1 & 0x3;
    const int m3 = b1 & 0x7c;
    const int m4 = b1 & 0x80;
    const int m5 = b2 & 0xf;
    const int m6 = b2 & 0xf0;
    const int m7 = b3 & 0x1;
    const int m8 = b3 & 0x3e;
    const int m9 = b3 & 0xc0;
    const int m10 = b4 & 0x7;
    const int m11 = b4 & 0xf8;
    accum0 += m0 * x0[0];
    accum0 += m1 * x0[1];
    accum0 += m2 * (x0[1] * 256.0f);
    accum0 += m3 * x0[2];
    accum0 += m4 * x0[3];
    accum0 += m5 * (x0[3] * 256.0f);
    accum0 += m6 * x0[4];
    accum0 += m7 * (x0[4] * 256.0f);
    accum0 += m8 * x0[5];
    accum0 += m9 * x0[6];
    accum0 += m10 * (x0[6] * 256.0f);
    accum0 += m11 * x0[7];
    accum1 += m0 * x1[0];
    accum1 += m1 * x1[1];
    accum1 += m2 * (x1[1] * 256.0f);
    accum1 += m3 * x1[2];
    accum1 += m4 * x1[3];
    accum1 += m5 * (x1[3] * 256.0f);
    accum1 += m6 * x1[4];
    accum1 += m7 * (x1[4] * 256.0f);
    accum1 += m8 * x1[5];
    accum1 += m9 * x1[6];
    accum1 += m10 * (x1[6] * 256.0f);
    accum1 += m11 * x1[7];
  }
  dot0 = scale * accum0 + sum0 * bias;
  dot1 = scale * accum1 + sum1 * bias;
}

inline void project_pair(const device bfloat *input,
    const device uchar *weights, const device uchar *scales,
    const device uchar *biases, device bfloat *output,
    device atomic_uint *diagnostics, constant FlashAffineParams &p,
    uint3 group, uint simd_group, uint lane) {
  if (p.rows != 4 || p.selections != 1 || p.experts != 1 ||
      p.output_size != 2560 || p.input_size != 6144 ||
      p.bits != 5 || p.group_size != 128 || p.flags ||
      p.weight_row_stride_bytes < 3840 ||
      p.parameter_row_stride_bytes < 96 ||
      p.parameter_row_stride_bytes % 2 ||
      p.parameter_expert_stride_bytes % 2) {
    if (lane == 0)
      atomic_fetch_or_explicit(diagnostics, 2u, memory_order_relaxed);
    return;
  }
  const uint out_row = group.x * 8 + simd_group * 4;
  const ulong route0 = ulong(group.y) * 2, route1 = route0 + 1;
  if (out_row >= p.output_size || route1 >= p.rows || group.z) return;
  const device bfloat *x0 = input + route0 * p.input_size;
  const device bfloat *x1 = input + route1 * p.input_size;
  thread float x_thread0[16], x_thread1[16];
  thread float result0[4] = {0}, result1[4] = {0};
  // Original fast Q5 Values16/Block512: exactly twelve whole-K chunks.
  for (uint k = 0; k < p.input_size; k += 512) {
    const uint channel = k + lane * 16;
    const float sum0 = raw_q5_literal::mlx_qmv_f32xsum_v1_load_vector<
        bfloat, float, 16, 5>(x0 + channel, x_thread0);
    const float sum1 = raw_q5_literal::mlx_qmv_f32xsum_v1_load_vector<
        bfloat, float, 16, 5>(x1 + channel, x_thread1);
    const uint coefficient = channel / 128;
    for (ushort row = 0; row < 4; ++row) {
      const device uchar *wl = weights +
          ulong(out_row + row) * p.weight_row_stride_bytes + ulong(channel) * 5 / 8;
      const ulong offset = ulong(out_row + row) * p.parameter_row_stride_bytes;
      const device bfloat *sl = reinterpret_cast<const device bfloat *>(scales + offset);
      const device bfloat *bl = reinterpret_cast<const device bfloat *>(biases + offset);
      const float s = float(sl[coefficient]), b = float(bl[coefficient]);
      float dot0, dot1;
      qdot_pair(wl, x_thread0, x_thread1, s, b, sum0, sum1, dot0, dot1);
      result0[row] += dot0;
      result1[row] += dot1;
    }
  }
  for (ushort row = 0; row < 4; ++row) {
    const float sum0 = simd_sum(result0[row]);
    if (lane == 0) {
      const bfloat value0 = bfloat(sum0);
      if (!raw_q5_literal::finite(sum0) || !raw_q5_literal::finite(float(value0)))
        atomic_fetch_or_explicit(diagnostics, 4u, memory_order_relaxed);
      output[route0 * p.output_size + out_row + row] = value0;
    }
    const float sum1 = simd_sum(result1[row]);
    if (lane == 0) {
      const bfloat value1 = bfloat(sum1);
      if (!raw_q5_literal::finite(sum1) || !raw_q5_literal::finite(float(value1)))
        atomic_fetch_or_explicit(diagnostics, 4u, memory_order_relaxed);
      output[route1 * p.output_size + out_row + row] = value1;
    }
  }
}
} // namespace raw_q5_rowpair_sep22
