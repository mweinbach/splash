DECODE_BF16_V3_BUILD ?= build/prefill4k-qsa-bulk-gathered-bf16-sep21-v3
DECODE_BF16_V3_SOURCE := $(DECODE_BF16_V3_BUILD)/source
DECODE_BF16_V3_OBJECTS := $(sort $(wildcard $(DECODE_BF16_V3_BUILD)/host/*.o))
DECODE_BF16_V3_NON_WORKER_OBJECTS := $(filter-out $(DECODE_BF16_V3_BUILD)/host/FlashWorker.o,$(DECODE_BF16_V3_OBJECTS))
DECODE_BF16_V3_WORKER_OBJECT := $(DECODE_BF16_V3_BUILD)/host/FlashWorker.o
DECODE_BF16_V3_FLAGS := -I$(DECODE_BF16_V3_SOURCE)/runtime -I$(DECODE_BF16_V3_SOURCE)/dev/benchmarks/prefill4k_attention
$(DECODE_BF16_V3_WORKER_OBJECT): $(DECODE_BF16_V3_SOURCE)/runtime/flash/FlashWorker.mm $(DECODE_BF16_V3_BUILD)/overlay-manifest.json
	$(CXX) $(DECODE_BF16_V3_FLAGS) $(ENGINE_OBJCXXFLAGS) -MMD -MP -c $< -o $@
$(DECODE_BF16_V3_BUILD)/splash-flash: $(DECODE_BF16_V3_WORKER_OBJECT) $(DECODE_BF16_V3_NON_WORKER_OBJECTS) $(FLASH_CORE_OBJECTS) $(DECODE_BF16_V3_BUILD)/splash.metallib
	$(CXX) $(ENGINE_OBJCXXFLAGS) $(DECODE_BF16_V3_WORKER_OBJECT) $(DECODE_BF16_V3_NON_WORKER_OBJECTS) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@
.PHONY: decode-bf16-v3-worker-cpu
decode-bf16-v3-worker-cpu: $(DECODE_BF16_V3_BUILD)/splash-flash
	$(DECODE_BF16_V3_BUILD)/splash-flash --cpu-self-test
