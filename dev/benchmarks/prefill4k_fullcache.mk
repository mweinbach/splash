# Unique private worker with extended cache inventory; no production mutation.
PREFILL4K_FULLCACHE_BUILD ?= build/prefill4k-fullcache
PREFILL4K_FULLCACHE_SOURCE := $(PREFILL4K_FULLCACHE_BUILD)/source
PREFILL4K_FULLCACHE_MANIFEST := $(PREFILL4K_FULLCACHE_BUILD)/overlay-manifest.json
PREFILL4K_FULLCACHE_CONFIG := $(CONFIG_DIGEST)-private-fullcache-v1
PREFILL4K_FULLCACHE_FLAGS := -I$(PREFILL4K_FULLCACHE_SOURCE)/runtime
PREFILL4K_FULLCACHE_CPP := $(patsubst runtime/flash/%.cpp,$(PREFILL4K_FULLCACHE_BUILD)/host/%.o,$(FLASH_CPP_SOURCES))
PREFILL4K_FULLCACHE_MM := $(patsubst runtime/flash/%.mm,$(PREFILL4K_FULLCACHE_BUILD)/host/%.o,$(FLASH_MM_SOURCES))
PREFILL4K_FULLCACHE_OBJECTS := $(PREFILL4K_FULLCACHE_CPP) $(PREFILL4K_FULLCACHE_MM)
PREFILL4K_FULLCACHE_AIR := $(PREFILL4K_FULLCACHE_BUILD)/metal/flash_int8_expert_store.air
PREFILL4K_FULLCACHE_OTHER_AIRS := $(filter-out $(METAL_BUILD)/shared/flash_int8_expert_store.air,$(PRODUCTION_AIRS))
PREFILL4K_FULLCACHE_LIB := $(PREFILL4K_FULLCACHE_BUILD)/splash.metallib
PREFILL4K_FULLCACHE_WORKER := $(PREFILL4K_FULLCACHE_BUILD)/splash-flash
PREFILL4K_FULLCACHE_ATTRIBUTION := $(PREFILL4K_FULLCACHE_BUILD)/prefill4k-attribution
PREFILL4K_FULLCACHE_METADATA := $(PREFILL4K_FULLCACHE_BUILD)/metadata-cpu
PREFILL4K_FULLCACHE_ORACLE := $(PREFILL4K_FULLCACHE_BUILD)/expert-oracle
PREFILL4K_FULLCACHE_TARGETS := $(PREFILL4K_FULLCACHE_OBJECTS) $(PREFILL4K_FULLCACHE_AIR) $(PREFILL4K_FULLCACHE_LIB) $(PREFILL4K_FULLCACHE_WORKER) $(PREFILL4K_FULLCACHE_ATTRIBUTION) $(PREFILL4K_FULLCACHE_METADATA) $(PREFILL4K_FULLCACHE_ORACLE)
$(PREFILL4K_FULLCACHE_TARGETS): BUILD_CONFIG := $(PREFILL4K_FULLCACHE_CONFIG)
PREFILL4K_FULLCACHE_STALE := $(shell $(BUILD_ID_PYTHON) $(BUILD_CONFIG_TOOL) stale --config $(PREFILL4K_FULLCACHE_CONFIG) $(PREFILL4K_FULLCACHE_TARGETS))
$(PREFILL4K_FULLCACHE_STALE): force-build-config
$(PREFILL4K_FULLCACHE_BUILD)/host/%.o: $(PREFILL4K_FULLCACHE_SOURCE)/runtime/flash/%.cpp $(PREFILL4K_FULLCACHE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_FULLCACHE_FLAGS) $(ENGINE_CXXFLAGS) -MMD -MP -c $< -o $@
$(PREFILL4K_FULLCACHE_BUILD)/host/%.o: $(PREFILL4K_FULLCACHE_SOURCE)/runtime/flash/%.mm $(PREFILL4K_FULLCACHE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_FULLCACHE_FLAGS) $(ENGINE_OBJCXXFLAGS) -MMD -MP -c $< -o $@
$(PREFILL4K_FULLCACHE_AIR): $(PREFILL4K_FULLCACHE_SOURCE)/runtime/metal/kernels/shared/flash_int8_expert_store.metal $(KERNEL_HEADERS) $(PREFILL4K_FULLCACHE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(METAL) $(PROD_METALFLAGS) -c $< -o $@
$(PREFILL4K_FULLCACHE_LIB): $(PREFILL4K_FULLCACHE_AIR) $(PREFILL4K_FULLCACHE_OTHER_AIRS)
	$(RUN_CONFIGURED) $(METALLIB) $(BUILD_INPUTS) -o $@
$(PREFILL4K_FULLCACHE_WORKER): $(PREFILL4K_FULLCACHE_OBJECTS) $(FLASH_CORE_OBJECTS) $(PREFILL4K_FULLCACHE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(ENGINE_OBJCXXFLAGS) $(PREFILL4K_FULLCACHE_OBJECTS) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@
$(PREFILL4K_FULLCACHE_ATTRIBUTION): dev/benchmarks/prefill4k_attribution.mm $(filter-out $(PREFILL4K_FULLCACHE_BUILD)/host/FlashWorker.o,$(PREFILL4K_FULLCACHE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(PREFILL4K_FULLCACHE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_FULLCACHE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(filter-out $(PREFILL4K_FULLCACHE_BUILD)/host/FlashWorker.o,$(PREFILL4K_FULLCACHE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@
$(PREFILL4K_FULLCACHE_METADATA): $(PREFILL4K_FULLCACHE_SOURCE)/dev/benchmarks/flash_int8_expert_store_metadata_cpu.mm $(PREFILL4K_FULLCACHE_BUILD)/host/FlashInt8ExpertStoreMetadata.o
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_FULLCACHE_FLAGS) $(ENGINE_OBJCXXFLAGS) $(BUILD_INPUTS) -framework Foundation -o $@
$(PREFILL4K_FULLCACHE_ORACLE): $(PREFILL4K_FULLCACHE_SOURCE)/dev/benchmarks/flash_int8_expert_store_oracle.mm $(filter-out $(PREFILL4K_FULLCACHE_BUILD)/host/FlashWorker.o,$(PREFILL4K_FULLCACHE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(PREFILL4K_FULLCACHE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_FULLCACHE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(filter-out $(PREFILL4K_FULLCACHE_BUILD)/host/FlashWorker.o,$(PREFILL4K_FULLCACHE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@
-include $(PREFILL4K_FULLCACHE_OBJECTS:.o=.d)
.PHONY: prefill4k-fullcache prefill4k-fullcache-cpu
prefill4k-fullcache: $(PREFILL4K_FULLCACHE_WORKER) $(PREFILL4K_FULLCACHE_ATTRIBUTION) $(PREFILL4K_FULLCACHE_METADATA) $(PREFILL4K_FULLCACHE_ORACLE)
prefill4k-fullcache-cpu: $(PREFILL4K_FULLCACHE_WORKER) $(PREFILL4K_FULLCACHE_METADATA) $(PREFILL4K_FULLCACHE_ORACLE)
	$(PREFILL4K_FULLCACHE_WORKER) --cpu-self-test
	$(PREFILL4K_FULLCACHE_METADATA)
	$(PREFILL4K_FULLCACHE_ORACLE) --cpu-self-test
