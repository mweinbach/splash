# Isolated source build. No target executes Metal or creates a GPU resource.
GDN_PREPARED_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../../..)
GDN_PREPARED_SOURCE := $(GDN_PREPARED_ROOT)/dev/benchmarks/gdn_chunk_sep21
GDN_PREPARED_BUILD ?= $(GDN_PREPARED_ROOT)/build/gdn-chunk-prepared-sep21
GDN_PREPARED_CXX := xcrun -sdk macosx clang++
GDN_PREPARED_FLAGS := -std=c++20 -O3 -ffp-contract=off -fno-fast-math -Wall -Wextra -Werror -Wno-deprecated-declarations -I$(GDN_PREPARED_ROOT)/runtime -mmacosx-version-min=27.0
GDN_PREPARED_METAL_FLAGS := -std=metal4.1 -O3 -Wall -Wextra -Werror -I$(GDN_PREPARED_ROOT)/runtime -mmacosx-version-min=27.0

.PHONY: all
all: $(GDN_PREPARED_BUILD)/cpu-oracle $(GDN_PREPARED_BUILD)/metal-oracle-prepared $(GDN_PREPARED_BUILD)/gdn-chunk-prepared.metallib

$(GDN_PREPARED_BUILD):
	mkdir -p $@

$(GDN_PREPARED_BUILD)/cpu-oracle.o: $(GDN_PREPARED_SOURCE)/cpu_oracle.cpp $(GDN_PREPARED_SOURCE)/cpu_oracle.hpp $(GDN_PREPARED_SOURCE)/PreparedMakefile | $(GDN_PREPARED_BUILD)
	$(GDN_PREPARED_CXX) $(GDN_PREPARED_FLAGS) -DGDN_CPU_ORACLE_NO_MAIN -c $< -o $@

$(GDN_PREPARED_BUILD)/cpu-oracle: $(GDN_PREPARED_SOURCE)/cpu_oracle.cpp $(GDN_PREPARED_SOURCE)/cpu_oracle.hpp $(GDN_PREPARED_SOURCE)/PreparedMakefile | $(GDN_PREPARED_BUILD)
	$(GDN_PREPARED_CXX) $(GDN_PREPARED_FLAGS) $< -o $@

$(GDN_PREPARED_BUILD)/metal-oracle-prepared: $(GDN_PREPARED_SOURCE)/metal_oracle_prepared.mm $(GDN_PREPARED_SOURCE)/cpu_oracle.hpp $(GDN_PREPARED_SOURCE)/PreparedMakefile $(GDN_PREPARED_ROOT)/runtime/metal/abi/FlashGDN.h $(GDN_PREPARED_BUILD)/cpu-oracle.o
	$(GDN_PREPARED_CXX) $(GDN_PREPARED_FLAGS) -fobjc-arc $< $(GDN_PREPARED_BUILD)/cpu-oracle.o -framework Foundation -framework Metal -o $@

$(GDN_PREPARED_BUILD)/prepared.air: $(GDN_PREPARED_SOURCE)/prepared.metal $(GDN_PREPARED_ROOT)/runtime/metal/abi/FlashGDN.h | $(GDN_PREPARED_BUILD)
	xcrun -sdk macosx metal $(GDN_PREPARED_METAL_FLAGS) -c $< -o $@

$(GDN_PREPARED_BUILD)/canonical.air: $(GDN_PREPARED_ROOT)/runtime/metal/kernels/shared/flash_gdn_staged.metal $(GDN_PREPARED_ROOT)/runtime/metal/abi/FlashGDN.h | $(GDN_PREPARED_BUILD)
	xcrun -sdk macosx metal $(GDN_PREPARED_METAL_FLAGS) -c $< -o $@

$(GDN_PREPARED_BUILD)/gdn-chunk-prepared.metallib: $(GDN_PREPARED_BUILD)/prepared.air $(GDN_PREPARED_BUILD)/canonical.air
	xcrun -sdk macosx metallib $^ -o $@
