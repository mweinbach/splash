# Include after Makefile and prefill4k_wide.mk. Compile only, never submit GPU.
PREFILL4K_WIDE_STATE_HEADER := $(PREFILL4K_WIDE_BUILD)/state-source/runtime/flash/FlashForward.hpp
PREFILL4K_WIDE_STATE_ORACLE := $(PREFILL4K_WIDE_BUILD)/state-oracle
PREFILL4K_WIDE_STATE_CONFIG := $(PREFILL4K_WIDE_CONFIG)-state-oracle-v1
PREFILL4K_WIDE_STATE_INPUTS := $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o $(PREFILL4K_WIDE_BUILD)/host/FlashForward.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS)
PREFILL4K_WIDE_STATE_FLAGS := -I$(PREFILL4K_WIDE_BUILD)/state-source/runtime $(PREFILL4K_WIDE_FLAGS) -I. \
	-DPREFILL4K_WIDE_STATE_FORWARD_SOURCE='"$(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.cpp"' \
	-DPREFILL4K_WIDE_STATE_ACCESS_HEADER='"$(PREFILL4K_WIDE_STATE_HEADER)"'

$(PREFILL4K_WIDE_STATE_HEADER): dev/benchmarks/prefill4k_wide_state_overlay.py $(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.hpp $(PREFILL4K_WIDE_MANIFEST)
	$(BUILD_ID_PYTHON) dev/benchmarks/prefill4k_wide_state_overlay.py --build $(PREFILL4K_WIDE_BUILD)

$(PREFILL4K_WIDE_STATE_ORACLE): BUILD_CONFIG := $(PREFILL4K_WIDE_STATE_CONFIG)
PREFILL4K_WIDE_STATE_STALE := $(shell $(BUILD_ID_PYTHON) $(BUILD_CONFIG_TOOL) stale --config $(PREFILL4K_WIDE_STATE_CONFIG) $(PREFILL4K_WIDE_STATE_ORACLE))
$(PREFILL4K_WIDE_STATE_STALE): force-build-config

$(PREFILL4K_WIDE_STATE_ORACLE): dev/benchmarks/prefill4k_wide_state.mm $(PREFILL4K_WIDE_STATE_HEADER) $(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.cpp $(PREFILL4K_WIDE_STATE_INPUTS) $(PREFILL4K_WIDE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_STATE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(PREFILL4K_WIDE_STATE_INPUTS) $(ENGINE_LINKFLAGS) -o $@

.PHONY: prefill4k-wide-state prefill4k-wide-state-cpu
prefill4k-wide-state: $(PREFILL4K_WIDE_STATE_ORACLE)
prefill4k-wide-state-cpu: $(PREFILL4K_WIDE_STATE_ORACLE)
	$(PREFILL4K_WIDE_STATE_ORACLE) --cpu-self-test
