BUILD ?= build/prefill4k-gdn-pair
CXX := xcrun -sdk macosx clang++
METAL := xcrun -sdk macosx metal
FLAGS := -std=c++20 -O3 -Wall -Wextra -Werror -Iruntime -mmacosx-version-min=27.0 -DSPLASH_INT8_EXPERIMENT=1
METALFLAGS := -std=metal4.1 -O3 -Wall -Wextra -Werror -Iruntime -mmacosx-version-min=27.0
OBJECTS := $(BUILD)/MetalBackend.o $(BUILD)/DeviceCapabilities.o $(BUILD)/oracle.o
AIRS := $(BUILD)/flash_gdn_staged.air $(BUILD)/flash_gdn.air $(BUILD)/gdn_delayq.air $(BUILD)/gdn_single_ilp.air
.PHONY: all cpu-self-test
all: $(BUILD)/oracle $(BUILD)/randomized-oracle $(BUILD)/gdn.metallib
$(BUILD):
	mkdir -p $@
$(BUILD)/MetalBackend.o: runtime/metal/MetalBackend.mm | $(BUILD)
	$(CXX) $(FLAGS) -fobjc-arc -MMD -MP -c $< -o $@
$(BUILD)/DeviceCapabilities.o: runtime/metal/DeviceCapabilities.cpp | $(BUILD)
	$(CXX) $(FLAGS) -MMD -MP -c $< -o $@
$(BUILD)/oracle.o: dev/benchmarks/prefill4k_dense/gdn_actual_oracle.mm | $(BUILD)
	$(CXX) $(FLAGS) -fobjc-arc -MMD -MP -c $< -o $@
$(BUILD)/oracle: $(OBJECTS)
	$(CXX) $(FLAGS) -fobjc-arc $(OBJECTS) -framework Foundation -framework Metal -framework IOKit -o $@
$(BUILD)/randomized-oracle.o: dev/benchmarks/prefill4k_dense/gdn_randomized_oracle.mm dev/benchmarks/prefill4k_dense/gdn_actual_oracle.mm | $(BUILD)
	$(CXX) $(FLAGS) -fobjc-arc -MMD -MP -c $< -o $@
$(BUILD)/randomized-oracle: $(BUILD)/randomized-oracle.o $(filter-out $(BUILD)/oracle.o,$(OBJECTS))
	$(CXX) $(FLAGS) -fobjc-arc $^ -framework Foundation -framework Metal -framework IOKit -o $@
$(BUILD)/flash_gdn%.air: runtime/metal/kernels/shared/flash_gdn%.metal | $(BUILD)
	$(METAL) $(METALFLAGS) -c $< -o $@
$(BUILD)/flash_gdn.air: runtime/metal/kernels/shared/flash_gdn.metal | $(BUILD)
	$(METAL) $(METALFLAGS) -c $< -o $@
$(BUILD)/gdn_%.air: dev/benchmarks/prefill4k_dense/gdn_%.metal | $(BUILD)
	$(METAL) $(METALFLAGS) -c $< -o $@
$(BUILD)/gdn.metallib: $(AIRS)
	xcrun -sdk macosx metallib $(AIRS) -o $@
cpu-self-test: $(BUILD)/oracle
	$(BUILD)/oracle --cpu-self-test
-include $(OBJECTS:.o=.d)
