# Include after Makefile and prefill4k_wide.mk. Sources are snapshotted by
# bulk_runtime_overlay.py. This builds only private outputs and runs no GPU.
PREFILL4K_BULK_PRIVATE := $(PREFILL4K_WIDE_SOURCE)/dev/benchmarks/prefill4k_attention
PREFILL4K_WIDE_FLAGS += -I$(PREFILL4K_BULK_PRIVATE)
PREFILL4K_BULK_CONFIG := $(PREFILL4K_WIDE_CONFIG)-qsa-bulk-sg8-v1
PREFILL4K_BULK_OBJECTS := $(PREFILL4K_WIDE_BUILD)/host/Prefill4kQSABulk.o $(PREFILL4K_WIDE_BUILD)/host/Prefill4kQSACoalesced.o
PREFILL4K_BULK_AIR := $(PREFILL4K_WIDE_BUILD)/metal/prefill4k_bulk_attention_sg8.air
PREFILL4K_WIDE_EXCLUDED_AIRS += $(METAL_BUILD)/shared/flash_qsa_bulk.air
PREFILL4K_WIDE_OBJECTS += $(PREFILL4K_BULK_OBJECTS)
PREFILL4K_BULK_TARGETS := $(PREFILL4K_WIDE_CONFIG_TARGETS) $(PREFILL4K_BULK_OBJECTS) $(PREFILL4K_BULK_AIR)
$(PREFILL4K_BULK_TARGETS): BUILD_CONFIG := $(PREFILL4K_BULK_CONFIG)
PREFILL4K_BULK_STALE := $(shell $(BUILD_ID_PYTHON) $(BUILD_CONFIG_TOOL) stale --config $(PREFILL4K_BULK_CONFIG) $(PREFILL4K_BULK_TARGETS))
$(PREFILL4K_BULK_STALE): force-build-config

$(PREFILL4K_WIDE_BUILD)/host/Prefill4kQSABulk.o: $(PREFILL4K_BULK_PRIVATE)/bulk.cpp $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_CXXFLAGS) -MMD -MP -c $< -o $@
$(PREFILL4K_WIDE_BUILD)/host/Prefill4kQSACoalesced.o: $(PREFILL4K_BULK_PRIVATE)/coalesced.cpp $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_CXXFLAGS) -MMD -MP -c $< -o $@
$(PREFILL4K_BULK_AIR): $(PREFILL4K_BULK_PRIVATE)/bulk_attention_sg8.metal $(KERNEL_HEADERS) $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(METAL) $(PREFILL4K_WIDE_FLAGS) $(PROD_METALFLAGS) -c $< -o $@
$(PREFILL4K_WIDE_LIB): $(PREFILL4K_BULK_AIR)
$(PREFILL4K_WIDE_WORKER) $(PREFILL4K_WIDE_ATTRIBUTION) $(PREFILL4K_WIDE_MEMORY) $(PREFILL4K_WIDE_EXPERT_ORACLE): $(PREFILL4K_BULK_OBJECTS)

-include $(PREFILL4K_BULK_OBJECTS:.o=.d)
.PHONY: prefill4k-qsa-bulk-runtime
prefill4k-qsa-bulk-runtime: $(PREFILL4K_WIDE_WORKER) $(PREFILL4K_WIDE_ATTRIBUTION) $(PREFILL4K_WIDE_MEMORY)
