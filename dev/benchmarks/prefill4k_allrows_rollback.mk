# Include after Makefile and prefill4k_wide.mk, pointing WIDE_BUILD at NEW copy.
PREFILL4K_ALLROWS_ROLLBACK := $(PREFILL4K_WIDE_BUILD)/rollback-oracle
PREFILL4K_ALLROWS_ROLLBACK_CONFIG := $(PREFILL4K_WIDE_CONFIG)-allrows-rollback-v1
PREFILL4K_ALLROWS_ROLLBACK_INPUTS := $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o $(PREFILL4K_WIDE_BUILD)/host/FlashForward.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS)
PREFILL4K_ALLROWS_ROLLBACK_FLAGS := $(PREFILL4K_WIDE_FLAGS) -I. \
  -DPREFILL4K_WIDE_STATE_FORWARD_SOURCE='"$(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.cpp"' \
  -DPREFILL4K_WIDE_STATE_ACCESS_HEADER='"$(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.hpp"'

$(PREFILL4K_ALLROWS_ROLLBACK): BUILD_CONFIG := $(PREFILL4K_ALLROWS_ROLLBACK_CONFIG)
PREFILL4K_ALLROWS_ROLLBACK_STALE := $(shell $(BUILD_ID_PYTHON) $(BUILD_CONFIG_TOOL) stale --config $(PREFILL4K_ALLROWS_ROLLBACK_CONFIG) $(PREFILL4K_ALLROWS_ROLLBACK))
$(PREFILL4K_ALLROWS_ROLLBACK_STALE): force-build-config
$(PREFILL4K_ALLROWS_ROLLBACK): dev/benchmarks/prefill4k_allrows_rollback.mm dev/benchmarks/prefill4k_wide_state.mm $(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.cpp $(PREFILL4K_WIDE_SOURCE)/runtime/flash/FlashForward.hpp $(PREFILL4K_WIDE_MANIFEST) $(PREFILL4K_ALLROWS_ROLLBACK_INPUTS) $(PREFILL4K_WIDE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_ALLROWS_ROLLBACK_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(PREFILL4K_ALLROWS_ROLLBACK_INPUTS) $(ENGINE_LINKFLAGS) -o $@

.PHONY: prefill4k-allrows-rollback prefill4k-allrows-rollback-cpu
prefill4k-allrows-rollback: $(PREFILL4K_ALLROWS_ROLLBACK)
prefill4k-allrows-rollback-cpu: $(PREFILL4K_ALLROWS_ROLLBACK)
	$(PREFILL4K_ALLROWS_ROLLBACK) --cpu-self-test
