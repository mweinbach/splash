# Include after the normal Makefile. Sources are generated before make; no GPU
# work is performed by this target or its CPU self-test.
PREFILL4K_WIDE_BUILD ?= build/prefill4k-wide
PREFILL4K_WIDE_FULLCACHE ?= 0
PREFILL4K_WIDE_SOURCE := $(PREFILL4K_WIDE_BUILD)/source
PREFILL4K_WIDE_MANIFEST := $(PREFILL4K_WIDE_BUILD)/overlay-manifest.json
PREFILL4K_WIDE_CONFIG := $(CONFIG_DIGEST)-private-wide-v1
PREFILL4K_WIDE_FLAGS := -I$(PREFILL4K_WIDE_SOURCE)/runtime
# Older sealed snapshots predate the public bulk route and link their own
# experiment objects. New snapshots include these public sources normally.
PREFILL4K_WIDE_ABSENT_BULK_SOURCES := $(foreach source,runtime/flash/FlashQSABulk.cpp runtime/flash/FlashQSABulkPrepare.cpp,$(if $(wildcard $(PREFILL4K_WIDE_SOURCE)/$(source)),,$(source)))
PREFILL4K_WIDE_CPP_OBJECTS := $(patsubst runtime/flash/%.cpp,$(PREFILL4K_WIDE_BUILD)/host/%.o,$(filter-out $(PREFILL4K_WIDE_ABSENT_BULK_SOURCES),$(FLASH_CPP_SOURCES)))
PREFILL4K_WIDE_MM_OBJECTS := $(patsubst runtime/flash/%.mm,$(PREFILL4K_WIDE_BUILD)/host/%.o,$(FLASH_MM_SOURCES))
PREFILL4K_WIDE_OBJECTS := $(PREFILL4K_WIDE_CPP_OBJECTS) $(PREFILL4K_WIDE_MM_OBJECTS)
PREFILL4K_WIDE_SHADER_NAMES := flash_gdn flash_gdn_fused flash_gdn_staged
PREFILL4K_WIDE_EXTRA_SHADER_NAMES ?=
PREFILL4K_WIDE_SHADER_NAMES += $(PREFILL4K_WIDE_EXTRA_SHADER_NAMES)
ifeq ($(PREFILL4K_WIDE_FULLCACHE),1)
PREFILL4K_WIDE_SHADER_NAMES += flash_int8_expert_store
PREFILL4K_WIDE_CONFIG := $(CONFIG_DIGEST)-private-wide-fullcache-v1
else ifneq ($(PREFILL4K_WIDE_FULLCACHE),0)
$(error PREFILL4K_WIDE_FULLCACHE must be 0 or 1)
endif
PREFILL4K_WIDE_AIRS := $(addprefix $(PREFILL4K_WIDE_BUILD)/metal/,$(addsuffix .air,$(PREFILL4K_WIDE_SHADER_NAMES)))
PREFILL4K_WIDE_REUSED_AIRS := $(filter-out $(addprefix $(METAL_BUILD)/shared/,$(addsuffix .air,$(PREFILL4K_WIDE_SHADER_NAMES))),$(PRODUCTION_AIRS))
PREFILL4K_WIDE_LIB := $(PREFILL4K_WIDE_BUILD)/splash.metallib
PREFILL4K_WIDE_WORKER := $(PREFILL4K_WIDE_BUILD)/splash-flash
PREFILL4K_WIDE_ATTRIBUTION := $(PREFILL4K_WIDE_BUILD)/prefill4k-attribution
PREFILL4K_WIDE_MEMORY := $(PREFILL4K_WIDE_BUILD)/memory-cpu
PREFILL4K_WIDE_METADATA := $(PREFILL4K_WIDE_BUILD)/metadata-cpu
PREFILL4K_WIDE_EXPERT_ORACLE := $(PREFILL4K_WIDE_BUILD)/expert-oracle
PREFILL4K_WIDE_EXTRA_TARGETS := $(PREFILL4K_WIDE_MEMORY)
ifeq ($(PREFILL4K_WIDE_FULLCACHE),1)
PREFILL4K_WIDE_EXTRA_TARGETS += $(PREFILL4K_WIDE_METADATA) $(PREFILL4K_WIDE_EXPERT_ORACLE)
endif

PREFILL4K_WIDE_CONFIG_TARGETS := $(PREFILL4K_WIDE_OBJECTS) $(PREFILL4K_WIDE_AIRS) $(PREFILL4K_WIDE_LIB) $(PREFILL4K_WIDE_WORKER) $(PREFILL4K_WIDE_ATTRIBUTION) $(PREFILL4K_WIDE_EXTRA_TARGETS)
$(PREFILL4K_WIDE_CONFIG_TARGETS): BUILD_CONFIG := $(PREFILL4K_WIDE_CONFIG)
PREFILL4K_WIDE_STALE_TARGETS := $(shell $(BUILD_ID_PYTHON) $(BUILD_CONFIG_TOOL) stale --config $(PREFILL4K_WIDE_CONFIG) $(PREFILL4K_WIDE_CONFIG_TARGETS))
$(PREFILL4K_WIDE_STALE_TARGETS): force-build-config

$(PREFILL4K_WIDE_BUILD)/host/%.o: $(PREFILL4K_WIDE_SOURCE)/runtime/flash/%.cpp $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_CXXFLAGS) -MMD -MP -c $< -o $@

$(PREFILL4K_WIDE_BUILD)/host/%.o: $(PREFILL4K_WIDE_SOURCE)/runtime/flash/%.mm $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_OBJCXXFLAGS) -MMD -MP -c $< -o $@

$(PREFILL4K_WIDE_BUILD)/metal/%.air: $(PREFILL4K_WIDE_SOURCE)/runtime/metal/kernels/shared/%.metal $(KERNEL_HEADERS) $(PREFILL4K_WIDE_MANIFEST)
	@mkdir -p $(dir $@)
	$(RUN_CONFIGURED) $(METAL) $(PREFILL4K_WIDE_FLAGS) $(PROD_METALFLAGS) -c $< -o $@

$(PREFILL4K_WIDE_LIB): $(PREFILL4K_WIDE_AIRS) $(PREFILL4K_WIDE_REUSED_AIRS)
	$(RUN_CONFIGURED) $(METALLIB) $(filter-out $(PREFILL4K_WIDE_EXCLUDED_AIRS),$(BUILD_INPUTS)) -o $@

$(PREFILL4K_WIDE_WORKER): $(PREFILL4K_WIDE_OBJECTS) $(FLASH_CORE_OBJECTS) $(PREFILL4K_WIDE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(ENGINE_OBJCXXFLAGS) $(PREFILL4K_WIDE_OBJECTS) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@

$(PREFILL4K_WIDE_ATTRIBUTION): dev/benchmarks/prefill4k_attribution.mm $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(PREFILL4K_WIDE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@

$(PREFILL4K_WIDE_MEMORY): dev/benchmarks/prefill4k_wide_memory.mm $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@

$(PREFILL4K_WIDE_METADATA): $(PREFILL4K_WIDE_SOURCE)/dev/benchmarks/flash_int8_expert_store_metadata_cpu.mm $(PREFILL4K_WIDE_BUILD)/host/FlashInt8ExpertStoreMetadata.o
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_OBJCXXFLAGS) $(BUILD_INPUTS) -framework Foundation -o $@

$(PREFILL4K_WIDE_EXPERT_ORACLE): $(PREFILL4K_WIDE_SOURCE)/dev/benchmarks/flash_int8_expert_store_oracle.mm $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(PREFILL4K_WIDE_LIB)
	$(RUN_CONFIGURED) $(CXX) $(PREFILL4K_WIDE_FLAGS) $(ENGINE_OBJCXXFLAGS) $< $(filter-out $(PREFILL4K_WIDE_BUILD)/host/FlashWorker.o,$(PREFILL4K_WIDE_OBJECTS)) $(FLASH_CORE_OBJECTS) $(ENGINE_LINKFLAGS) -o $@

-include $(PREFILL4K_WIDE_OBJECTS:.o=.d)
.PHONY: prefill4k-wide prefill4k-wide-cpu
prefill4k-wide: $(PREFILL4K_WIDE_WORKER) $(PREFILL4K_WIDE_ATTRIBUTION) $(PREFILL4K_WIDE_EXTRA_TARGETS)
prefill4k-wide-cpu: $(PREFILL4K_WIDE_WORKER)
	$(PREFILL4K_WIDE_WORKER) --cpu-self-test
